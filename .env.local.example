# ============================================
# 阿里云百炼 DashScope API 配置模板
# 官方文档：https://help.aliyun.com/zh/model-studio/first-api-call-to-qwen
# ============================================
#
# 【使用方法】
#   1. 复制本文件为 .env.local（.env.local 已被 gitignore，不会被提交）
#   2. 开通百炼：https://bailian.console.aliyun.com/
#   3. 创建 API Key：https://bailian.console.aliyun.com/?tab=model#/api-key
#   4. 把 Key 填到 DASHSCOPE_API_KEY="" 的引号中
#
# 【Key 格式】sk-xxxxxxxxxxxxxxxx（创建时只显示一次，记得保存！）
# ============================================

DASHSCOPE_API_KEY=

# Base URL（OpenAI 兼容模式官方固定值）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可用模型 ID（官方列表）：
#   qwen3.8-max / qwen3-max / qwen-max（旗舰最强推理）
#   qwen3.6-plus / qwen3.5-plus / qwen-plus（均衡，推荐首选）
#   qwen3.6-flash / qwen3.5-flash / qwen-flash（轻量快速）
#   qwen-turbo（最便宜）
# 完整列表：https://help.aliyun.com/zh/model-studio/models
# QWEN_MODEL=qwen-plus
# QWEN_PROJECT_TUTOR_MODEL=qwen-plus
